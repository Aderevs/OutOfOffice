@using OutOfOffice.DbLogic
@model EmployeeEditBinding
@{
    ViewData["Title"] = "Редагувати інформацію про працівника";
}

<div class="col-md-4">
    <h1 class="display-4">Редагувати інформацію</h1>
    @if (Model.HasPhoto)
    {
        <img src="https://localhost:7129/Employees/GetPhotoById?id=@Model.ID" alt="Фото працівника" class="employee-photo" />
    }
    <form asp-action="Edit" enctype="multipart/form-data">
        <div class="form-group">
            <label asp-for="ID" class="control-label"></label>
            <input asp-for="ID" class="form-control" readonly />
        </div>
        <div class="form-group">
            <label asp-for="FullName" class="control-label"></label>
            @if (Model.IsActive &&
                (User.IsInRole("HRManager") || User.IsInRole("Administrator")))
            {
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            }
            else
            {
                <input asp-for="FullName" class="form-control" readonly />
            }

        </div>

        <div class="form-group">
            <label asp-for="Subdivision" class="control-label"></label>
            @if (Model.IsActive &&
                (User.IsInRole("HRManager") || User.IsInRole("Administrator")))
            {
                <select asp-for="Subdivision" asp-items="EnumHelper.GetSelectListItemsFromEnum<Subdivision>()" class="form-control"></select>
                <span asp-validation-for="Subdivision" class="text-danger"></span>
            }
            else
            {
                <input asp-for="Subdivision" class="form-control" readonly />
            }

        </div>

        <div class="form-group">
            <label asp-for="Position" class="control-label"></label>
            @if (Model.IsActive &&
                (User.IsInRole("Administrator")))
            {
                <select asp-for="Position" asp-items="EnumHelper.GetSelectListItemsFromEnum<Position>()" class="form-control"></select>
                <span asp-validation-for="Position" class="text-danger"></span>
            }
            else
            {
                <input asp-for="Position" class="form-control" readonly />
            }

        </div>

        <div class="form-group">
            <label asp-for="OutOfOfficeBalance" class="control-label"></label>
            @if (Model.IsActive &&
                (User.IsInRole("HRManager") || User.IsInRole("Administrator")))
            {
                <input asp-for="OutOfOfficeBalance" class="form-control" />
                <span asp-validation-for="OutOfOfficeBalance" class="text-danger"></span>
            }
            else
            {
                <input asp-for="OutOfOfficeBalance" class="form-control" readonly />
            }
        </div>

        <div class="form-group">
            <label asp-for="SickLeaveBalance" class="control-label"></label>
            @if (Model.IsActive &&
            (User.IsInRole("HRManager") || User.IsInRole("Administrator")))
            {
                <input asp-for="SickLeaveBalance" class="form-control" />
                <span asp-validation-for="SickLeaveBalance" class="text-danger"></span>
            }
            else
            {
                <input asp-for="SickLeaveBalance" class="form-control" readonly />
            }
        </div>

        <div class="form-group">
            <label asp-for="PeoplePartnerId" class="control-label"></label>
            @if (Model.IsActive &&
                (User.IsInRole("Administrator")))
            {
                <select asp-for="PeoplePartnerId" asp-items="Model.HROptions" class="form-control"></select>
                <span asp-validation-for="PeoplePartnerId" class="text-danger"></span>
            }
            else
            {
                <select asp-for="PeoplePartnerId" asp-items="Model.HROptions" class="form-control" disabled></select>
            }
        </div>


        <br />
        @if (Model.IsActive &&
            (User.IsInRole("HRManager") || User.IsInRole("Administrator")))
        {
            <div class="form-group">
                <label asp-for="Photo"></label>
                <input asp-for="Photo" type="file" class="form-control" />
                <span asp-validation-for="Photo" class="text-danger"></span>
            </div>
        }


        <br />
        @if (Model.IsActive &&
            (User.IsInRole("ProjectManager")))
        {
            <div class="form-group">
                <label asp-for="ProjectsIds"></label>
                <select asp-for="ProjectsIds" asp-items="Model.AllProjects" class="form-control"></select>
                <span asp-validation-for="ProjectsIds" class="text-danger"></span>
            </div>
        }

        <br />
        <div class="form-group">
            <input type="submit" value="Зберегти" class="btn btn-primary" />
        </div>
    </form>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

