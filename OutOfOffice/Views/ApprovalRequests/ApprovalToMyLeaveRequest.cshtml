@model ApprovalRequestView

@{
    ViewData["Title"] = "Запити на затвердження";
}

<div>
    <h4>ID:</h4>
    <h6>@Model.ID</h6>
    <h4>Причина:</h4>
    <h6>@Model.AbsenceReason</h6>
    <h4>ID запита на відсутність:</h4>
    <h6>@Model.LeaveID</h6>
    <h4>Початок:</h4>
    <h6>@Model.StartDate</h6>
    <h4>завершення:</h4>
    <h6>@Model.EndDate</h6>
    <h4>Коментар до запиту:</h4>
    @if (string.IsNullOrEmpty(Model.LeaveComment))
    {
        <h6>______________________________</h6>
    }
    <h6>@Model.LeaveComment</h6>
    <h4>Статус затвердження:</h4>
    <h6>@Model.Status</h6>
    <h4>Апрувер:</h4>
    <h6>@Model.ApproverName</h6>
    <h4>Коментар апрувера:</h4>
    @if (string.IsNullOrEmpty(Model.Comment))
    {
        <h6>______________________________</h6>
    }
    <h6>@Model.Comment</h6>

</div>