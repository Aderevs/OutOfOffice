@model List<ApprovalRequestView>

@{
    ViewData["Title"] = "Approval requests";
    var requestsJson = System.Text.Json.JsonSerializer.Serialize(Model);
}

<table class="tables">
    <thead id="approvalrequests-table-head">
        <tr>
            <th><button class="btn" onclick="sortById()">ID</button></th>
            <th><button class="btn" onclick="sortByReason()">Причина</button></th>
            <th><button class="btn" onclick="sortByLeaveId()">ID запиту на відсутність</button></th>
            <th><button class="btn" onclick="sortByStartDate()">Початок</button></th>
            <th><button class="btn" onclick="sortByEndDate()">Закінчення</button></th>
            <th><button class="btn" onclick="sortByApproverName()">Апрувер</button></th>
            <th><button class="btn" onclick="sortByStatus()">Статус</button></th>
        </tr>
    </thead>
    <tbody id="approvalrequests-table-body"></tbody>
</table>

<script>
    let requests = @Html.Raw(requestsJson);
    let tableBody = document.getElementById("approvalrequests-table-body");
    let currentSorting = "IDAscending";

    function displayTableBody() {
        tableBody.innerHTML = "";
        requests.forEach(function (request) {
            let row = document.createElement("tr");
            //let translatedStatus = '';
            // switch (request.Status) {
            //     case 'New':
            //         translatedStatus = 'Новий';
            //         break;
            //     case 'Submit':
            //         translatedStatus = 'Затверджений';
            //         break;
            //     case 'Cancel':
            //         translatedStatus = 'Відхилений';
            //         break;
            //     default:
            //         break;
            // }

            row.innerHTML =
                `<td>${request.ID}</td>
                    <td>${request.AbsenceReason}</td>
                    <td>${request.LeaveID}</td>
                    <td>${request.StartDate}</td>
                    <td>${request.EndDate}</td>
                    <td>${request.ApproverName}</td>
                    <td>${request.Status}</td>
                            <td><a href="https://localhost:7129/ApprovalRequests/ApprovalToMyLeaveRequest?id=${request.ID}">Деталі</a></td>`;
            tableBody.appendChild(row);
        });
    }

    displayTableBody();

    function sortById() {
        if (currentSorting === "IDAscending") {
            currentSorting = "IDDescending";
            requests.reverse();
        } else {
            currentSorting = "IDAscending";
            requests.sort((a, b) => a.ID - b.ID);
        }
        displayTableBody();

    }function sortByLeaveId() {
        if (currentSorting === "LeaveIDAscending") {
            currentSorting = "LeaveIDDescending";
            requests.reverse();
        } else {
            currentSorting = "LeaveIDAscending";
            requests.sort((a, b) => a.LeaveID - b.LeaveID);
        }
        displayTableBody();
    }

    function sortByApproverName() {
        if (currentSorting === "ApproverAscending") {
            currentSorting = "ApproverDescending";
            requests.reverse();
        } else {
            currentSorting = "ApproverAscending";
            requests.sort((a, b) => a.ApproverName.localeCompare(b.ApproverName));
        }
        displayTableBody();
    }

    function sortByReason() {
        if (currentSorting === "ReasonAscending") {
            currentSorting = "ReasonDescending";
            requests.reverse();
        } else {
            currentSorting = "ReasonAscending";
            requests.sort((a, b) => a.AbsenceReason.localeCompare(b.AbsenceReason));
        }
        displayTableBody();
    }

    function sortByStartDate() {
        if (currentSorting === "StartAscending") {
            currentSorting = "StartDescending";
            requests.reverse();
        } else {
            currentSorting = "StartAscending";
            requests.sort((a, b) => a.StartDate.localeCompare(b.StartDate));
        }
        displayTableBody();
    }

    function sortByEndDate() {
        if (currentSorting === "EndAscending") {
            currentSorting = "EndDescending";
            requests.reverse();
        } else {
            currentSorting = "EndAscending";
            requests.sort((a, b) => a.EndDate.localeCompare(b.EndDate));
        }
        displayTableBody();
    }

    function sortByStatus() {
        if (currentSorting === "StatusAscending") {
            currentSorting = "StatusDescending";
            requests.reverse();
        } else {
            currentSorting = 'StatusAscending';
            requests.sort((a, b) => a.Status.localeCompare(b.Status));
        }
        displayTableBody();
    }

</script>
